# Copy to /etc/soopi/soopi.env on the VPS; never commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DOTNET_CLI_TELEMETRY_OPTOUT=true
ConnectionStrings__Default=Server=db,1433;Database=TrungTamBaoHanhDB;User ID=soopi_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;
Security__AllowedOrigins=https://soopiwarranty.id.vn
AllowedHosts=soopiwarranty.id.vn
Security__DefaultResetPassword=CHANGE_ME
Security__Jwt__PrivateKeyLocation=/run/soopi-keys/private.pem
Security__Jwt__PublicKeyLocation=/run/soopi-keys/public.pem
Storage__Directory=/data/files
Sla__Alerts__Enabled=false
Sms__Provider=log
Push__Provider=log
