{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-vite",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "--prefix",
        "frontend-react",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-dotnet",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend-dotnet/src/Soopi.Api",
        "--launch-profile",
        "http",
        "--",
        "--urls",
        "http://localhost:8080",
        "--Sla:Alerts:Enabled=false"
      ],
      "port": 8080
    }
  ]
}